# Optional independent admin password for the self-hosted account boundary.
# Use a long unique value supplied by the operator's secret manager.
ATLAS_ADMIN_PASSWORD=

# Optional server-only GitHub token for authenticated private reads and
# permission-checked pull-request proposals. Never expose this to the browser.
GITHUB_TOKEN=

# Set to 1 whenever the browser reaches Atlas over HTTPS.
ATLAS_COOKIE_SECURE=0

# Optional port for the single Node process.
PORT=4173

# Optional network bind. The safe local default is used when omitted.
HOST=127.0.0.1
